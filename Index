      /**
       * ======================================================================
       * 7. EXAM ENGINE — START, RESUME, TIMER, RENDER, ELIMINATION, NAVIGATE
       * ======================================================================
       */
      function startSession(overrideMode) {
        const mode = overrideMode || selectedLobbyMode;
        const shuffleQs = document.getElementById('shuffleQuestionsChk').checked;
        const shuffleOpts = document.getElementById('shuffleOptionsChk').checked;
        const durationSec = parseInt(document.getElementById('durationSelect').value, 10) || 1800;

        let pool = EXAM_BANK;
        if (mode === 'missed') {
          const missedIds = getMissedQuestionIds();
          if (missedIds.length > 0) {
            pool = EXAM_BANK.filter((q) => missedIds.includes(q.id));
          }
        }

        let questions = pool.map((q) => ({
          ...q,
          options: shuffleOpts ? shuffle(q.options) : [...q.options]
        }));
        if (shuffleQs) questions = shuffle(questions);

        runningSession = {
          mode,
          candidateName: (memory.profile.name || '').trim() || 'Candidate',
          candidateId: (memory.profile.id || '').trim() || 'N/A',
          startedAt: Date.now(),
          index: 0,
          remainingSeconds: durationSec,
          elapsedSeconds: 0,
          questions,
          answers: {},      // { [qId]: string }
          eliminated: {},   // { [qId]: string[] }
          flagged: [],      // number[]
          notes: ''
        };

        memory.activeSession = runningSession;
        saveMemory();
        playCue('tap');
        enterExamWorkspace();
      }

      function resumeSession() {
        if (!memory.activeSession) return;
        runningSession = memory.activeSession;
        playCue('tap');
        enterExamWorkspace();
        toast('Resumed saved examination');
      }

      function enterExamWorkspace() {
        document.getElementById('scratchpadArea').value = runningSession.notes || '';
        const modeLabels = {
          exam: 'Official Exam Mode • Timed',
          study: 'Study Mode • Instant Verification',
          missed: 'Weak Questions Drill • Instant Verification'
        };
        document.getElementById('examModeIndicator').textContent = modeLabels[runningSession.mode] || 'Exam Mode';

        showView('viewExam');
        renderQuestion();
        renderNavigatorGrids();
        startClock();
      }

      function startClock() {
        stopClock();
        updateClockUI();
        timerId = setInterval(() => {
          if (!runningSession) {
            stopClock();
            return;
          }
          runningSession.elapsedSeconds += 1;
          if (runningSession.mode === 'exam') {
            runningSession.remainingSeconds = Math.max(0, runningSession.remainingSeconds - 1);
            updateClockUI();
            if (runningSession.remainingSeconds === 300) {
              toast('5 minutes remaining');
            }
            if (runningSession.remainingSeconds <= 0) {
              stopClock();
              toast('Time expired — grading exam automatically');
              completeAndGradeExam();
              return;
            }
          } else {
            updateClockUI();
          }

          if (runningSession.elapsedSeconds % 5 === 0) {
            memory.activeSession = runningSession;
            saveMemory();
          }
        }, 1000);
      }

      function stopClock() {
        if (timerId) {
          clearInterval(timerId);
          timerId = null;
        }
      }

      function updateClockUI() {
        if (!runningSession) return;
        const pill = document.getElementById('timerPill');
        const txt = document.getElementById('timerText');

        if (runningSession.mode === 'exam') {
          const r = runningSession.remainingSeconds;
          txt.textContent = formatClock(r);
          if (r <= 300) {
            pill.className = 'flex items-center gap-2 px-3 py-1.5 rounded-xl bg-rose-950 border border-rose-500 font-mono text-sm sm:text-base font-bold tracking-wider text-rose-300 animate-pulse';
          } else {
            pill.className = 'flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-800 border border-slate-700 font-mono text-sm sm:text-base font-bold tracking-wider text-white';
          }
        } else {
          txt.textContent = formatClock(runningSession.elapsedSeconds);
          pill.className = 'flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-800 border border-slate-700 font-mono text-sm sm:text-base font-bold tracking-wider text-emerald-300';
        }
      }

      function renderQuestion() {
        if (!runningSession) return;
        const idx = runningSession.index;
        const total = runningSession.questions.length;
        const q = runningSession.questions[idx];
        const chosen = runningSession.answers[q.id];
        const struck = runningSession.eliminated[q.id] || [];
        const isFlagged = runningSession.flagged.includes(q.id);
        const answeredCount = Object.keys(runningSession.answers).length;
        const instantFeedback = runningSession.mode !== 'exam';

        // Progress & Counters
        document.getElementById('examProgressFill').style.width = `${(answeredCount / total) * 100}%`;
        document.getElementById('sidebarCountBadge').textContent = `${answeredCount} / ${total}`;
        document.getElementById('mobileGridBadge').textContent = `${answeredCount}/${total}`;
        document.getElementById('mobileSheetCount').textContent = `${answeredCount} of ${total} answered`;

        document.getElementById('examQCounter').textContent = `Question ${idx + 1} of ${total}`;
        document.getElementById('examQRef').textContent = `BANK ITEM #${String(q.id).padStart(2, '0')} • 1.00 MARK`;

        const statePill = document.getElementById('examQStatePill');
        if (chosen !== undefined) {
          statePill.textContent = 'Answer Saved';
          statePill.className = 'px-2.5 py-1 rounded-full text-xs font-semibold bg-sky-50 dark:bg-sky-950/60 text-sky-700 dark:text-sky-300 border border-sky-200 dark:border-sky-800';
        } else {
          statePill.textContent = 'Not Yet Answered';
          statePill.className = 'px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300';
        }

        // Flag Button
        const flagBtn = document.getElementById('flagBtn');
        const flagSvg = document.getElementById('flagSvg');
        const flagLbl = document.getElementById('flagLabel');
        if (isFlagged) {
          flagBtn.className = 'inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-amber-400 bg-amber-50 dark:bg-amber-950/50 text-amber-800 dark:text-amber-200 text-xs sm:text-sm font-semibold transition-colors';
          flagSvg.className = 'w-4 h-4 text-amber-500 fill-amber-400';
          flagLbl.textContent = 'Flagged';
        } else {
          flagBtn.className = 'inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 hover:border-amber-400 text-slate-700 dark:text-slate-200 text-xs sm:text-sm font-semibold transition-colors';
          flagSvg.className = 'w-4 h-4 text-slate-400';
          flagLbl.textContent = 'Flag for Review';
        }

        // Stem
        document.getElementById('examQuestionText').textContent = q.question;

        // Choices
        const container = document.getElementById('examOptionsList');
        container.innerHTML = '';
        const letters = ['a', 'b', 'c', 'd'];

        q.options.forEach((opt, i) => {
          const isSelected = chosen === opt;
          const isStruck = struck.includes(opt);
          const letter = letters[i] || String(i + 1);

          let rowCls = 'border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/50 hover:border-sky-400 dark:hover:border-sky-500';
          let badgeCls = 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border-slate-200 dark:border-slate-600';

          if (instantFeedback && chosen !== undefined) {
            if (opt === q.correct) {
              rowCls = 'border-emerald-500 bg-emerald-50/80 dark:bg-emerald-950/40 ring-1 ring-emerald-500';
              badgeCls = 'bg-emerald-600 text-white border-emerald-600';
            } else if (isSelected && opt !== q.correct) {
              rowCls = 'border-rose-500 bg-rose-50/80 dark:bg-rose-950/40 ring-1 ring-rose-500';
              badgeCls = 'bg-rose-600 text-white border-rose-600';
            }
          } else if (isSelected) {
            rowCls = 'border-sky-600 bg-sky-50/80 dark:bg-sky-950/40 ring-1 ring-sky-600';
            badgeCls = 'bg-sky-600 text-white border-sky-600';
          }

          const wrapper = document.createElement('div');
          wrapper.className = `group relative rounded-xl border-2 transition-all flex items-stretch ${rowCls}`;

          const mainBtn = document.createElement('button');
          mainBtn.type = 'button';
          mainBtn.className = 'flex-1 text-left p-3.5 sm:p-4 flex items-start gap-3.5 focus:outline-none min-w-0';
          mainBtn.innerHTML = `
            <span class="w-7 h-7 rounded-lg border text-xs font-bold uppercase flex items-center justify-center shrink-0 mt-0.5 transition-colors ${badgeCls}">
              ${letter}
            </span>
            <span class="text-sm sm:text-base font-medium leading-snug pt-0.5 break-words ${isStruck && !isSelected ? 'line-through opacity-45' : 'text-slate-800 dark:text-slate-100'}">
              ${opt}
            </span>
          `;

          mainBtn.addEventListener('click', () => chooseOption(q.id, opt));
          mainBtn.addEventListener('contextmenu', (e) => {
            e.preventDefault();
            toggleStrikeOption(q.id, opt);
          });

          // Strike-through / Eliminate button (CBT realism)
          const strikeBtn = document.createElement('button');
          strikeBtn.type = 'button';
          strikeBtn.title = isStruck ? 'Restore option' : 'Cross out distractor';
          strikeBtn.className = `px-3 flex items-center justify-center border-l border-slate-200/70 dark:border-slate-700/70 text-xs font-bold transition-colors rounded-r-xl ${isStruck ? 'text-rose-500 bg-rose-50/50 dark:bg-rose-950/30' : 'text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-100/70 dark:hover:bg-slate-800'}`;
          strikeBtn.innerHTML = `<span class="sr-only">Cross out</span>✕`;
          strikeBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            toggleStrikeOption(q.id, opt);
          });

          wrapper.appendChild(mainBtn);
          wrapper.appendChild(strikeBtn);
          container.appendChild(wrapper);
        });

        // Instant Study Feedback Panel
        const fbPanel = document.getElementById('studyFeedbackPanel');
        if (instantFeedback && chosen !== undefined) {
          const isRight = chosen === q.correct;
          fbPanel.classList.remove('hidden');
          if (isRight) {
            fbPanel.className = 'mt-5 p-4 rounded-xl border border-emerald-200 dark:border-emerald-800 bg-emerald-50 dark:bg-emerald-950/40 text-emerald-900 dark:text-emerald-200 text-sm flex items-start gap-3';
            document.getElementById('studyFeedbackIcon').innerHTML = `<svg class="w-5 h-5 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>`;
            document.getElementById('studyFeedbackBody').innerHTML = `<strong>Correct!</strong> Matches official PromExam Code 7 answer key.`;
          } else {
            fbPanel.className = 'mt-5 p-4 rounded-xl border border-rose-200 dark:border-rose-800 bg-rose-50 dark:bg-rose-950/40 text-rose-900 dark:text-rose-200 text-sm flex items-start gap-3';
            document.getElementById('studyFeedbackIcon').innerHTML = `<svg class="w-5 h-5 text-rose-600 dark:text-rose-400" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>`;
            document.getElementById('studyFeedbackBody').innerHTML = `<strong>Incorrect.</strong> The correct answer is: <span class="font-bold underline">${q.correct}</span>`;
          }
        } else {
          fbPanel.classList.add('hidden');
        }

        // Clear & Nav Buttons
        document.getElementById('clearAnswerBtn').disabled = chosen === undefined;
        document.getElementById('prevQuestionBtn').disabled = idx === 0;
        const isLast = idx === total - 1;
        document.getElementById('nextQuestionBtn').classList.toggle('hidden', isLast);
        document.getElementById('reviewBeforeSubmitBtn').classList.toggle('hidden', !isLast);
      }

      function chooseOption(qId, optText) {
        if (!runningSession) return;
        runningSession.answers[qId] = optText;
        // Remove from eliminated if user explicitly picks it
        if (runningSession.eliminated[qId]) {
          runningSession.eliminated[qId] = runningSession.eliminated[qId].filter((x) => x !== optText);
        }

        if (runningSession.mode !== 'exam') {
          const q = runningSession.questions.find((item) => item.id === qId);
          playCue(q && q.correct === optText ? 'right' : 'wrong');
        } else {
          playCue('tap');
        }

        memory.activeSession = runningSession;
        saveMemory();
        renderQuestion();
        renderNavigatorGrids();
      }

      function toggleStrikeOption(qId, optText) {
        if (!runningSession) return;
        if (!runningSession.eliminated[qId]) runningSession.eliminated[qId] = [];
        const arr = runningSession.eliminated[qId];
        const pos = arr.indexOf(optText);
        if (pos >= 0) arr.splice(pos, 1);
        else arr.push(optText);
        playCue('tap');
        memory.activeSession = runningSession;
        saveMemory();
        renderQuestion();
      }

      function clearCurrentChoice() {
        if (!runningSession) return;
        const q = runningSession.questions[runningSession.index];
        delete runningSession.answers[q.id];
        playCue('tap');
        memory.activeSession = runningSession;
        saveMemory();
        renderQuestion();
        renderNavigatorGrids();
      }

      function toggleFlagCurrent() {
        if (!runningSession) return;
        const q = runningSession.questions[runningSession.index];
        const i = runningSession.flagged.indexOf(q.id);
        if (i >= 0) runningSession.flagged.splice(i, 1);
        else runningSession.flagged.push(q.id);
        playCue('flag');
        memory.activeSession = runningSession;
        saveMemory();
        renderQuestion();
        renderNavigatorGrids();
      }

      function navigateTo(index) {
        if (!runningSession) return;
        if (index < 0 || index >= runningSession.questions.length) return;
        runningSession.index = index;
        playCue('tap');
        memory.activeSession = runningSession;
        saveMemory();
        renderQuestion();
        renderNavigatorGrids();
      }

      function renderNavigatorGrids() {
        if (!runningSession) return;
        [document.getElementById('desktopGrid'), document.getElementById('mobileGrid')].forEach((grid) => {
          grid.innerHTML = '';
          runningSession.questions.forEach((q, idx) => {
            const isCurrent = idx === runningSession.index;
            const isAnswered = runningSession.answers[q.id] !== undefined;
            const isFlagged = runningSession.flagged.includes(q.id);

            let cls = 'relative h-10 rounded-xl font-bold text-xs flex items-center justify-center transition-all focus:outline-none ';
            if (isAnswered) {
              cls += 'bg-sky-600 text-white hover:bg-sky-700 ';
            } else {
              cls += 'bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-700 ';
            }
            if (isCurrent) {
              cls += 'ring-2 ring-slate-900 dark:ring-white ring-offset-2 dark:ring-offset-slate-900 ';
            }

            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = cls;
            btn.innerHTML = `
              <span>${idx + 1}</span>
              ${isFlagged ? '<span class="absolute -top-1 -right-1 w-3 h-3 rounded-full bg-amber-400 border-2 border-white dark:border-slate-900"></span>' : ''}
            `;
            btn.addEventListener('click', () => {
              navigateTo(idx);
              closeMobileSheet();
            });
            grid.appendChild(btn);
          });
        });
      }

      /**
       * ======================================================================
       * 8. PRE-SUBMIT SUMMARY SCREEN & FINAL GRADING
       * ======================================================================
       */
      function openPreSubmitSummary() {
        if (!runningSession) return;
        const total = runningSession.questions.length;
        const answered = Object.keys(runningSession.answers).length;
        const missing = total - answered;
        const flagged = runningSession.flagged.length;

        document.getElementById('preSumAnswered').textContent = answered;
        document.getElementById('preSumMissing').textContent = missing;
        document.getElementById('preSumFlagged').textContent = flagged;

        const list = document.getElementById('preSummaryList');
        list.innerHTML = '';

        runningSession.questions.forEach((q, idx) => {
          const isAns = runningSession.answers[q.id] !== undefined;
          const isFlag = runningSession.flagged.includes(q.id);

          const row = document.createElement('button');
          row.type = 'button';
          row.className = 'w-full text-left px-5 sm:px-6 py-3.5 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors flex items-center justify-between gap-4';
          row.innerHTML = `
            <div class="flex items-center gap-3 min-w-0">
              <span class="w-8 h-8 rounded-lg font-bold text-xs flex items-center justify-center shrink-0 ${isAns ? 'bg-sky-600 text-white' : 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300'}">${idx + 1}</span>
              <span class="text-sm font-medium text-slate-700 dark:text-slate-200 truncate">${q.question}</span>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              ${isFlag ? '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 dark:bg-amber-900/50 text-amber-800 dark:text-amber-200">Flagged</span>' : ''}
              <span class="text-xs font-bold ${isAns ? 'text-emerald-600 dark:text-emerald-400' : 'text-rose-600 dark:text-rose-400'}">
                ${isAns ? 'Saved' : 'Not answered'}
              </span>
            </div>
          `;
          row.addEventListener('click', () => {
            runningSession.index = idx;
            showView('viewExam');
            renderQuestion();
            renderNavigatorGrids();
          });
          list.appendChild(row);
        });

        showView('viewSummary');
      }

      function completeAndGradeExam() {
        if (!runningSession) return;
        stopClock();
        playCue('finish');

        const completedAt = Date.now();
        const total = runningSession.questions.length;
        let score = 0;

        // Update mastery memory per question
        runningSession.questions.forEach((q) => {
          const isRight = runningSession.answers[q.id] === q.correct;
          if (isRight) score++;

          if (!memory.mastery[q.id]) {
            memory.mastery[q.id] = { right: 0, wrong: 0, lastWrong: false };
          }
          if (isRight) {
            memory.mastery[q.id].right += 1;
            memory.mastery[q.id].lastWrong = false;
          } else {
            memory.mastery[q.id].wrong += 1;
            memory.mastery[q.id].lastWrong = true;
          }
        });

        const percentage = Math.round((score / total) * 100);
        const passed = percentage >= PASS_THRESHOLD;

        const transcript = {
          id: `tr_${completedAt}`,
          mode: runningSession.mode,
          candidateName: runningSession.candidateName,
          candidateId: runningSession.candidateId,
          startedAt: runningSession.startedAt,
          completedAt,
          durationSeconds: runningSession.elapsedSeconds || 1,
          score,
          total,
          percentage,
          passed,
          questions: runningSession.questions,
          answers: runningSession.answers,
          flagged: runningSession.flagged
        };

        memory.history.unshift(transcript);
        if (memory.history.length > 30) memory.history = memory.history.slice(0, 30);
        memory.activeSession = null;
        runningSession = null;
        saveMemory();

        openResults(transcript);
      }

      function pauseExamToLobby() {
        if (runningSession) {
          stopClock();
          memory.activeSession = runningSession;
          saveMemory();
          runningSession = null;
          toast('Exam paused and saved to memory');
        }
        renderLobby();
        showView('viewLobby');
      }

      /**
       * ======================================================================
       * 9. OFFICIAL RESULTS & AUDIT VIEW
       * ======================================================================
       */
      function openResults(transcript) {
        currentTranscript = transcript;
        auditFilter = 'all';

        const hero = document.getElementById('resultHero');
        const statusTag = document.getElementById('resStatusTag');
        const title = document.getElementById('resTitle');

        if (transcript.passed) {
          hero.className = 'rounded-2xl p-6 sm:p-8 border border-emerald-200 dark:border-emerald-800/70 bg-gradient-to-br from-emerald-50 to-teal-50 dark:from-emerald-950/50 dark:to-teal-950/40 text-emerald-950 dark:text-emerald-50 shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-6';
          statusTag.className = 'px-3 py-1 rounded-full text-xs font-extrabold uppercase tracking-wider bg-emerald-600 text-white';
          statusTag.textContent = 'PASSED';
          title.textContent = 'Congratulations, you have successfully passed the examination!';
        } else {
          hero.className = 'rounded-2xl p-6 sm:p-8 border border-rose-200 dark:border-rose-800/70 bg-gradient-to-br from-rose-50 to-orange-50 dark:from-rose-950/50 dark:to-orange-950/40 text-rose-950 dark:text-rose-50 shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-6';
          statusTag.className = 'px-3 py-1 rounded-full text-xs font-extrabold uppercase tracking-wider bg-rose-600 text-white';
          statusTag.textContent = 'NOT PASSED';
          title.textContent = 'Minimum passing mark (75%) not achieved. Review missed questions below.';
        }

        const modeText = transcript.mode === 'exam' ? 'Official Exam Mode' : (transcript.mode === 'missed' ? 'Weak Questions Drill' : 'Study Mode');
        document.getElementById('resModeTag').textContent = modeText;
        document.getElementById('resPercent').textContent = `${transcript.percentage}%`;
        document.getElementById('resMarks').textContent = `${transcript.score}/${transcript.total}`;

        document.getElementById('trCandidate').textContent = `${transcript.candidateName || 'Candidate'}${transcript.candidateId && transcript.candidateId !== 'N/A' ? ` (${transcript.candidateId})` : ''}`;
        document.getElementById('trStarted').textContent = formatFullTime(transcript.startedAt);
        document.getElementById('trCompleted').textContent = formatFullTime(transcript.completedAt);
        document.getElementById('trDuration').textContent = formatDuration(transcript.durationSeconds);
        document.getElementById('trGrade').textContent = `${transcript.percentage} out of 100 (${transcript.score}/${transcript.total} marks)`;

        updateAuditFilterUI();
        renderAuditList();
        showView('viewResults');
      }

      function updateAuditFilterUI() {
        document.querySelectorAll('.audit-filter').forEach((btn) => {
          const active = btn.dataset.filter === auditFilter;
          btn.className = active
            ? 'audit-filter px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-900 dark:bg-sky-600 text-white transition-colors'
            : 'audit-filter px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors';
        });
      }

      function renderAuditList() {
        if (!currentTranscript) return;
        const container = document.getElementById('auditList');
        container.innerHTML = '';

        const items = currentTranscript.questions
          .map((q, idx) => ({
            q,
            idx,
            userAns: currentTranscript.answers[q.id],
            isRight: currentTranscript.answers[q.id] === q.correct,
            isFlagged: (currentTranscript.flagged || []).includes(q.id)
          }))
          .filter((entry) => {
            if (auditFilter === 'correct') return entry.isRight;
            if (auditFilter === 'incorrect') return !entry.isRight;
            if (auditFilter === 'flagged') return entry.isFlagged;
            return true;
          });

        if (items.length === 0) {
          container.innerHTML = `
            <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-8 text-center text-sm text-slate-500">
              No questions match this filter.
            </div>
          `;
          return;
        }

        items.forEach(({ q, idx, userAns, isRight, isFlagged }) => {
          const card = document.createElement('div');
          card.className = `bg-white dark:bg-slate-900 rounded-2xl border ${isRight ? 'border-slate-200 dark:border-slate-800' : 'border-rose-300 dark:border-rose-800/70'} shadow-sm p-5 sm:p-6 space-y-4`;

          const optionsHtml = q.options.map((opt, i) => {
            const letter = ['a', 'b', 'c', 'd'][i] || i + 1;
            const isKey = opt === q.correct;
            const isPicked = opt === userAns;

            let cls = 'border-slate-100 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-800/40 text-slate-600 dark:text-slate-300';
            let tag = '';
            if (isKey) {
              cls = 'border-emerald-300 dark:border-emerald-700 bg-emerald-50 dark:bg-emerald-950/40 text-emerald-950 dark:text-emerald-100 font-semibold';
              tag = '<span class="ml-auto text-[11px] font-bold px-2 py-0.5 rounded bg-emerald-100 dark:bg-emerald-900 text-emerald-700 dark:text-emerald-300 shrink-0">Correct</span>';
            } else if (isPicked && !isKey) {
              cls = 'border-rose-300 dark:border-rose-700 bg-rose-50 dark:bg-rose-950/40 text-rose-950 dark:text-rose-100 font-semibold';
              tag = '<span class="ml-auto text-[11px] font-bold px-2 py-0.5 rounded bg-rose-100 dark:bg-rose-900 text-rose-700 dark:text-rose-300 shrink-0">Your Answer</span>';
            }

            return `
              <div class="p-3 rounded-xl border text-sm flex items-center gap-3 ${cls}">
                <span class="font-mono text-xs font-bold uppercase opacity-75">${letter}.</span>
                <span class="leading-snug">${opt}</span>
                ${tag}
              </div>
            `;
          }).join('');

          card.innerHTML = `
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div class="flex items-center gap-2">
                <span class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 text-xs font-bold">Q${idx + 1}</span>
                <span class="px-2.5 py-1 rounded-full text-xs font-bold ${isRight ? 'bg-emerald-100 dark:bg-emerald-900/50 text-emerald-700 dark:text-emerald-300' : 'bg-rose-100 dark:bg-rose-900/50 text-rose-700 dark:text-rose-300'}">
                  ${isRight ? 'Correct (1/1)' : (userAns === undefined ? 'Unanswered (0/1)' : 'Incorrect (0/1)')}
                </span>
                ${isFlagged ? '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 dark:bg-amber-900/50 text-amber-800 dark:text-amber-200">Flagged</span>' : ''}
              </div>
              <span class="text-xs font-mono text-slate-400">Item #${q.id}</span>
            </div>
            <h4 class="text-base font-bold text-slate-900 dark:text-white leading-relaxed">${q.question}</h4>
            <div class="space-y-2">${optionsHtml}</div>
            <div class="pt-2 border-t border-slate-100 dark:border-slate-800 text-xs text-slate-600 dark:text-slate-400">
              <span class="font-semibold text-slate-800 dark:text-slate-200">Feedback:</span> The correct answer is: <span class="font-bold text-emerald-700 dark:text-emerald-400">${q.correct}</span>
            </div>
          `;
          container.appendChild(card);
        });
      }

      /**
       * ======================================================================
       * 10. DRAWERS, MODALS & EVENT BINDINGS
       * ======================================================================
       */
      function openMobileSheet() {
        document.getElementById('mobileSheet').classList.remove('hidden');
      }
      function closeMobileSheet() {
        document.getElementById('mobileSheet').classList.add('hidden');
      }
      function openScratchpad() {
        const m = document.getElementById('scratchpadModal');
        m.classList.remove('hidden');
        m.classList.add('flex');
      }
      function closeScratchpad() {
        const m = document.getElementById('scratchpadModal');
        m.classList.add('hidden');
        m.classList.remove('flex');
      }

      function bindAllEvents() {
        // Header Controls
        document.getElementById('homeLogoBtn').addEventListener('click', () => {
          if (runningSession) pauseExamToLobby();
          else {
            renderLobby();
            showView('viewLobby');
          }
        });

        document.getElementById('themeToggleBtn').addEventListener('click', () => {
          memory.profile.darkMode = !memory.profile.darkMode;
          saveMemory();
          applyPreferences();
          playCue('tap');
        });

        document.getElementById('audioToggleBtn').addEventListener('click', () => {
          memory.profile.audio = !memory.profile.audio;
          saveMemory();
          applyPreferences();
          if (memory.profile.audio) playCue('tap');
          toast(memory.profile.audio ? 'Terminal sounds on' : 'Terminal sounds muted');
        });

        document.getElementById('fontSizeBtn').addEventListener('click', () => {
          memory.profile.fontScale = (memory.profile.fontScale + 1) % 3;
          saveMemory();
          applyPreferences();
          const names = ['Compact', 'Standard', 'Large'];
          toast(`Font size: ${names[memory.profile.fontScale]}`);
        });

        // Candidate Profile Auto-Save
        document.getElementById('candidateNameInput').addEventListener('input', (e) => {
          memory.profile.name = e.target.value;
          saveMemory();
          applyPreferences();
        });
        document.getElementById('candidateIdInput').addEventListener('input', (e) => {
          memory.profile.id = e.target.value;
          saveMemory();
          applyPreferences();
        });

        // Lobby Mode Cards
        document.querySelectorAll('.mode-card').forEach((card) => {
          card.addEventListener('click', () => {
            if (card.disabled) return;
            playCue('tap');
            selectLobbyMode(card.dataset.mode);
          });
        });

        // Lobby Launch & Resume
        document.getElementById('launchExamBtn').addEventListener('click', () => {
          if (memory.activeSession) {
            showConfirm({
              title: 'Replace Paused Session?',
              body: 'You have an unfinished attempt saved in memory. Starting a new exam will overwrite it.',
              okLabel: 'Start New Exam',
              onOk: () => {
                closeConfirm();
                startSession();
              }
            });
          } else {
            startSession();
          }
        });

        document.getElementById('resumeSavedBtn').addEventListener('click', resumeSession);
        document.getElementById('discardSavedBtn').addEventListener('click', () => {
          showConfirm({
            title: 'Discard Saved Exam?',
            body: 'Your progress in the paused attempt will be permanently deleted.',
            okLabel: 'Discard',
            danger: true,
            onOk: () => {
              closeConfirm();
              memory.activeSession = null;
              saveMemory();
              renderLobby();
              toast('Paused session discarded');
            }
          });
        });

        document.getElementById('resetMemoryBtn').addEventListener('click', () => {
          showConfirm({
            title: 'Clear All Exam Memory?',
            body: 'This will erase your attempt transcripts, statistics, and question mastery tracking.',
            okLabel: 'Clear Everything',
            danger: true,
            onOk: () => {
              closeConfirm();
              memory.history = [];
              memory.mastery = {};
              saveMemory();
              renderLobby();
              toast('Exam memory cleared');
            }
          });
        });

        // Exam Controls
        document.getElementById('prevQuestionBtn').addEventListener('click', () => navigateTo(runningSession.index - 1));
        document.getElementById('nextQuestionBtn').addEventListener('click', () => navigateTo(runningSession.index + 1));
        document.getElementById('flagBtn').addEventListener('click', toggleFlagCurrent);
        document.getElementById('clearAnswerBtn').addEventListener('click', clearCurrentChoice);
        document.getElementById('reviewBeforeSubmitBtn').addEventListener('click', openPreSubmitSummary);
        document.getElementById('sidebarReviewBtn').addEventListener('click', openPreSubmitSummary);
        document.getElementById('sidebarPauseBtn').addEventListener('click', pauseExamToLobby);

        // Mobile Navigator Sheet
        document.getElementById('openMobileGridBtn').addEventListener('click', openMobileSheet);
        document.getElementById('closeMobileSheetBtn').addEventListener('click', closeMobileSheet);
        document.getElementById('mobileSheetOverlay').addEventListener('click', closeMobileSheet);
        document.getElementById('mobilePauseBtn').addEventListener('click', () => {
          closeMobileSheet();
          pauseExamToLobby();
        });
        document.getElementById('mobileSummaryBtn').addEventListener('click', () => {
          closeMobileSheet();
          openPreSubmitSummary();
        });

        // Scratchpad
        document.getElementById('scratchpadToggleBtn').addEventListener('click', openScratchpad);
        document.getElementById('closeScratchpadBtn').addEventListener('click', closeScratchpad);
        document.getElementById('doneScratchpadBtn').addEventListener('click', closeScratchpad);
        document.getElementById('scratchpadOverlay').addEventListener('click', closeScratchpad);
        document.getElementById('scratchpadArea').addEventListener('input', (e) => {
          if (!runningSession) return;
          runningSession.notes = e.target.value;
          memory.activeSession = runningSession;
          saveMemory();
        });
        document.getElementById('clearScratchpadBtn').addEventListener('click', () => {
          document.getElementById('scratchpadArea').value = '';
          if (runningSession) {
            runningSession.notes = '';
            memory.activeSession = runningSession;
            saveMemory();
          }
        });

        // Pre-Submit Summary View
        document.getElementById('returnToAttemptBtn').addEventListener('click', () => {
          showView('viewExam');
          renderQuestion();
        });
        document.getElementById('finalSubmitBtn').addEventListener('click', () => {
          if (!runningSession) return;
          const missing = runningSession.questions.length - Object.keys(runningSession.answers).length;
          showConfirm({
            title: 'Submit Examination for Grading?',
            body: missing > 0
              ? `You have ${missing} unanswered question${missing === 1 ? '' : 's'}. Once submitted, you cannot modify your answers.`
              : 'All questions are answered. Confirm final submission to view your official score report.',
            okLabel: 'Submit & Grade',
            onOk: () => {
              closeConfirm();
              completeAndGradeExam();
            }
          });
        });

        // Results View
        document.getElementById('retakeBtn').addEventListener('click', () => {
          startSession(currentTranscript ? currentTranscript.mode : 'exam');
        });
        document.getElementById('goLobbyBtn').addEventListener('click', () => {
          renderLobby();
          showView('viewLobby');
        });
        document.querySelectorAll('.audit-filter').forEach((btn) => {
          btn.addEventListener('click', () => {
            auditFilter = btn.dataset.filter;
            updateAuditFilterUI();
            renderAuditList();
          });
        });

        // Confirm Dialog
        document.getElementById('confirmCancelBtn').addEventListener('click', closeConfirm);
        document.getElementById('confirmOverlay').addEventListener('click', closeConfirm);
        document.getElementById('confirmOkBtn').addEventListener('click', () => {
          if (typeof pendingConfirmAction === 'function') pendingConfirmAction();
        });

        // Keyboard Shortcuts in Active Exam View
        document.addEventListener('keydown', (e) => {
          if (!runningSession) return;
          const inExam = !document.getElementById('viewExam').classList.contains('hidden');
          const modalOpen = !document.getElementById('confirmDialog').classList.contains('hidden')
            || !document.getElementById('scratchpadModal').classList.contains('hidden');

          if (e.key === 'Escape') {
            closeConfirm();
            closeScratchpad();
            closeMobileSheet();
            return;
          }
          if (!inExam || modalOpen) return;

          const k = e.key.toLowerCase();
          const q = runningSession.questions[runningSession.index];
          if (k === 'arrowright') navigateTo(runningSession.index + 1);
          else if (k === 'arrowleft') navigateTo(runningSession.index - 1);
          else if (k === 'f') toggleFlagCurrent();
          else if (['a', 'b', 'c'].includes(k)) {
            const idx = ['a', 'b', 'c'].indexOf(k);
            if (q && q.options[idx]) chooseOption(q.id, q.options[idx]);
          }
        });
      }

      // Initialize App
      window.addEventListener('DOMContentLoaded', () => {
        applyPreferences();
        bindAllEvents();
        selectLobbyMode('exam');
        renderLobby();
      });
    })();
  </script>
</body>
</html>
