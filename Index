      const STORAGE_KEY = 'promexam_code7_memory_v3';
      const PASS_THRESHOLD = 75; // 75% passing standard

      /**
       * ======================================================================
       * 2. PERSISTENT MEMORY LAYER (LocalStorage with Safe Fallback)
       * ======================================================================
       */
      function createDefaultMemory() {
        return {
          profile: {
            name: '',
            id: '',
            darkMode: false,
            audio: true,
            fontScale: 1 // 0: compact, 1: standard, 2: large
          },
          activeSession: null,
          history: [],
          mastery: {} // { [questionId]: { right: number, wrong: number, lastWrong: boolean } }
        };
      }

      let memory = loadMemory();
      let selectedLobbyMode = 'exam'; // 'exam' | 'study' | 'missed'
      let runningSession = null;
      let timerId = null;
      let currentTranscript = null;
      let auditFilter = 'all';
      let pendingConfirmAction = null;

      function loadMemory() {
        try {
          const raw = localStorage.getItem(STORAGE_KEY);
          if (!raw) return createDefaultMemory();
          const parsed = JSON.parse(raw);
          return {
            ...createDefaultMemory(),
            ...parsed,
            profile: { ...createDefaultMemory().profile, ...(parsed.profile || {}) },
            mastery: parsed.mastery || {},
            history: Array.isArray(parsed.history) ? parsed.history : []
          };
        } catch (err) {
          return createDefaultMemory();
        }
      }

      function saveMemory() {
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(memory));
        } catch (err) {
          // Graceful degradation if storage quota exceeded or blocked
        }
      }

      /**
       * ======================================================================
       * 3. SYNTHETIC AUDIO FEEDBACK (TONE.JS)
       * ======================================================================
       */
      let toneSynth = null;
      function playCue(type) {
        if (!memory.profile.audio || typeof Tone === 'undefined') return;
        try {
          if (Tone.context.state !== 'running') Tone.start();
          if (!toneSynth) {
            toneSynth = new Tone.Synth({
              oscillator: { type: 'triangle' },
              envelope: { attack: 0.005, decay: 0.05, sustain: 0, release: 0.05 }
            }).toDestination();
            toneSynth.volume.value = -18;
          }
          const now = Tone.now();
          if (type === 'tap') toneSynth.triggerAttackRelease('D5', '32n', now);
          else if (type === 'flag') toneSynth.triggerAttackRelease('F#5', '32n', now);
          else if (type === 'right') toneSynth.triggerAttackRelease('A5', '16n', now);
          else if (type === 'wrong') toneSynth.triggerAttackRelease('C4', '16n', now);
          else if (type === 'finish') {
            toneSynth.triggerAttackRelease('C5', '16n', now);
            toneSynth.triggerAttackRelease('E5', '16n', now + 0.08);
            toneSynth.triggerAttackRelease('G5', '8n', now + 0.16);
          }
        } catch (_) {}
      }

      /**
       * ======================================================================
       * 4. UTILITY FUNCTIONS
       * ======================================================================
       */
      function shuffle(list) {
        const arr = [...list];
        for (let i = arr.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [arr[i], arr[j]] = [arr[j], arr[i]];
        }
        return arr;
      }

      function formatClock(sec) {
        const s = Math.max(0, Math.floor(sec));
        const m = Math.floor(s / 60);
        const r = s % 60;
        return `${String(m).padStart(2, '0')}:${String(r).padStart(2, '0')}`;
      }

      function formatDuration(sec) {
        const s = Math.max(0, Math.floor(sec));
        const m = Math.floor(s / 60);
        const r = s % 60;
        if (m === 0) return `${r} sec${r === 1 ? '' : 's'}`;
        return `${m} min${m === 1 ? '' : 's'} ${r} sec${r === 1 ? '' : 's'}`;
      }

      function formatFullTime(ts) {
        return new Date(ts).toLocaleString(undefined, {
          weekday: 'long',
          day: 'numeric',
          month: 'long',
          year: 'numeric',
          hour: 'numeric',
          minute: '2-digit'
        });
      }

      function formatCompactTime(ts) {
        return new Date(ts).toLocaleString(undefined, {
          month: 'short',
          day: 'numeric',
          hour: 'numeric',
          minute: '2-digit'
        });
      }

      function getMissedQuestionIds() {
        return Object.keys(memory.mastery)
          .map(Number)
          .filter((id) => memory.mastery[id] && memory.mastery[id].lastWrong);
      }

