<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>PromExam Code 7 — Aviation Maintenance CBT Simulator</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Inter & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet" />
  <!-- Tone.js for subtle synthetic CBT terminal audio -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js"></script>

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          }
        }
      }
    };
  </script>
</head>
<body class="bg-slate-100 dark:bg-slate-950 text-slate-900 dark:text-slate-100 font-sans antialiased min-h-screen flex flex-col transition-colors duration-200 selection:bg-sky-600 selection:text-white">

  <!-- ==================== TOP CBT TERMINAL BAR ==================== -->
  <header class="sticky top-0 z-30 bg-slate-900 dark:bg-slate-900/95 backdrop-blur border-b border-slate-800 text-white shadow-sm">
    <div class="max-w-7xl mx-auto px-3 sm:px-6 h-16 flex items-center justify-between gap-2 sm:gap-4">
      <!-- Left: System Identity -->
      <button id="homeLogoBtn" type="button" class="flex items-center gap-2.5 sm:gap-3 text-left group min-w-0 focus:outline-none">
        <div class="w-9 h-9 rounded-xl bg-sky-600 group-hover:bg-sky-500 transition-colors flex items-center justify-center shrink-0 shadow-inner">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
          </svg>
        </div>
        <div class="min-w-0">
          <div class="flex items-center gap-2">
            <span class="font-bold text-sm sm:text-base tracking-tight truncate">PromExam Code 7</span>
            <span class="hidden md:inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold tracking-wider uppercase bg-sky-500/20 text-sky-300 border border-sky-500/30">
              CBT Terminal
            </span>
          </div>
          <p id="headerCandidateLabel" class="text-[11px] text-slate-400 truncate">Aviation Maintenance Examination</p>
        </div>
      </button>

      <!-- Center: Live Timer & Exam Status (Only shown during Active Exam / Pre-Submit Review) -->
      <div id="examHeaderCenter" class="hidden items-center gap-2 sm:gap-3">
        <div id="timerPill" class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-800 border border-slate-700 font-mono text-sm sm:text-base font-bold tracking-wider">
          <svg class="w-4 h-4 text-sky-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          <span id="timerText">30:00</span>
        </div>
        <!-- Mobile Navigator Button -->
        <button id="openMobileGridBtn" type="button" class="lg:hidden inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs font-semibold text-slate-200 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <rect x="3" y="3" width="7" height="7" rx="1"></rect>
            <rect x="14" y="3" width="7" height="7" rx="1"></rect>
            <rect x="14" y="14" width="7" height="7" rx="1"></rect>
            <rect x="3" y="14" width="7" height="7" rx="1"></rect>
          </svg>
          <span id="mobileGridBadge">0/25</span>
        </button>
      </div>

      <!-- Right: Realistic Terminal Controls (Font Scale, Scratchpad, Audio, Theme) -->
      <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
        <!-- Scratchpad Button (Visible during Exam) -->
        <button id="scratchpadToggleBtn" type="button" class="hidden p-2 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-300 hover:text-white transition-colors" title="Exam Scratchpad">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
        </button>

        <!-- Text Size Cycle (CBT Accessibility) -->
        <button id="fontSizeBtn" type="button" class="hidden sm:inline-flex items-center justify-center px-2.5 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs font-bold text-slate-300 hover:text-white transition-colors" title="Adjust question font size">
          Aa
        </button>

        <!-- Sound Toggle -->
        <button id="audioToggleBtn" type="button" class="p-2 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-300 hover:text-white transition-colors" title="Toggle terminal sounds">
          <svg id="audioOnSvg" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
            <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
          </svg>
          <svg id="audioOffSvg" class="w-4 h-4 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
            <line x1="23" y1="9" x2="17" y2="15"></line>
            <line x1="17" y1="9" x2="23" y2="15"></line>
          </svg>
        </button>

        <!-- Dark Mode Toggle -->
        <button id="themeToggleBtn" type="button" class="p-2 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-300 hover:text-white transition-colors" title="Toggle Dark/Light Theme">
          <svg id="sunIcon" class="w-4 h-4 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <svg id="moonIcon" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Slim Live Progress Track -->
    <div id="examProgressTrack" class="hidden w-full h-1 bg-slate-800">
      <div id="examProgressFill" class="h-1 bg-sky-500 transition-all duration-300" style="width: 0%"></div>
    </div>
  </header>

  <!-- ==================== MAIN WORKSPACE ==================== -->
  <main class="flex-1 w-full max-w-7xl mx-auto px-3 sm:px-6 py-5 sm:py-8">

    <!-- ================================================================ -->
    <!-- VIEW 1: CANDIDATE LOBBY & EXAM LAUNCHER                          -->
    <!-- ================================================================ -->
    <section id="viewLobby" class="space-y-6">

      <!-- Auto-Saved Active Session Banner -->
      <div id="resumeBanner" class="hidden rounded-2xl border border-amber-300 dark:border-amber-500/40 bg-amber-50 dark:bg-amber-950/40 p-4 sm:p-5 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="flex items-start gap-3.5">
          <div class="w-11 h-11 rounded-xl bg-amber-500/20 text-amber-700 dark:text-amber-300 flex items-center justify-center shrink-0">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <div class="flex items-center gap-2 flex-wrap">
              <h2 class="text-sm sm:text-base font-bold text-amber-950 dark:text-amber-100">Session Recovered from Memory</h2>
              <span id="resumeBadge" class="px-2 py-0.5 rounded-full text-[11px] font-bold bg-amber-200 dark:bg-amber-800 text-amber-900 dark:text-amber-100">Official Exam</span>
            </div>
            <p id="resumeDetails" class="text-xs sm:text-sm text-amber-800 dark:text-amber-200/80 mt-0.5">0 of 25 answered • 30:00 left</p>
          </div>
        </div>
        <div class="flex items-center gap-2.5 w-full sm:w-auto">
          <button id="discardSavedBtn" type="button" class="flex-1 sm:flex-none px-4 py-2.5 rounded-xl border border-amber-300 dark:border-amber-700 bg-white dark:bg-slate-900 hover:bg-amber-100 dark:hover:bg-amber-900/40 text-amber-900 dark:text-amber-200 text-xs sm:text-sm font-semibold transition-colors">
            Discard
          </button>
          <button id="resumeSavedBtn" type="button" class="flex-1 sm:flex-none px-5 py-2.5 rounded-xl bg-amber-600 hover:bg-amber-700 text-white text-xs sm:text-sm font-bold shadow-sm transition-colors flex items-center justify-center gap-2">
            <span>Resume Exam</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </button>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

        <!-- Left Column: Candidate Check-in & Exam Setup (7 cols) -->
        <div class="lg:col-span-7 space-y-6">
          <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden">
            <!-- Hero Header -->
            <div class="p-6 sm:p-7 bg-gradient-to-br from-slate-900 via-slate-900 to-sky-950 text-white border-b border-slate-800">
              <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-sky-500/20 text-sky-300 border border-sky-400/30">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                  25 Verified Questions
                </span>
                <span class="font-mono text-xs text-slate-400">DOC: PromExamCode 7</span>
              </div>
              <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight">Promotion Examination — Code 7</h1>
              <p class="text-slate-300 text-sm mt-2 leading-relaxed">
                Realistic proctored testing simulator covering FAR/EASA Part 65 &amp; 66, Fuel Tank Safety &amp; CDCCL, EWIS, Human Factors (SHELL &amp; Dirty Dozen), and Maintenance Documentation.
              </p>

              <!-- Quick Specs Strip -->
              <div class="grid grid-cols-3 gap-2.5 sm:gap-3 mt-5">
                <div class="rounded-xl bg-white/5 border border-white/10 p-3">
                  <p class="text-[10px] sm:text-[11px] font-semibold uppercase tracking-wider text-slate-400">Bank Size</p>
                  <p class="text-base sm:text-lg font-bold mt-0.5">25 Items</p>
                </div>
                <div class="rounded-xl bg-white/5 border border-white/10 p-3">
                  <p class="text-[10px] sm:text-[11px] font-semibold uppercase tracking-wider text-slate-400">Pass Mark</p>
                  <p class="text-base sm:text-lg font-bold mt-0.5">75% <span class="text-xs font-normal text-slate-400">(19/25)</span></p>
                </div>
                <div class="rounded-xl bg-white/5 border border-white/10 p-3">
                  <p class="text-[10px] sm:text-[11px] font-semibold uppercase tracking-wider text-slate-400">Memory</p>
                  <p class="text-base sm:text-lg font-bold mt-0.5 text-emerald-400">Auto-Save</p>
                </div>
              </div>
            </div>

            <!-- Configuration Form -->
            <div class="p-5 sm:p-7 space-y-6">
              <!-- Candidate Check-In -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                <div>
                  <label for="candidateNameInput" class="block text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1.5">Candidate Name</label>
                  <input id="candidateNameInput" type="text" placeholder="e.g. Eng. Abebe T." class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-sky-500" />
                </div>
                <div>
                  <label for="candidateIdInput" class="block text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1.5">License / Staff ID</label>
                  <input id="candidateIdInput" type="text" placeholder="e.g. AMT-2047" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm font-mono font-medium focus:outline-none focus:ring-2 focus:ring-sky-500" />
                </div>
              </div>

              <!-- Mode Selector -->
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2">Examination Mode</label>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                  <button type="button" data-mode="exam" class="mode-card text-left p-3.5 rounded-xl border-2 border-sky-600 bg-sky-50/70 dark:bg-sky-950/40 transition-all focus:outline-none">
                    <div class="flex items-center justify-between mb-1">
                      <span class="font-bold text-sm text-slate-900 dark:text-white">Official Exam</span>
                      <span class="mode-dot w-3.5 h-3.5 rounded-full border-4 border-sky-600 bg-white"></span>
                    </div>
                    <p class="text-[11px] text-slate-600 dark:text-slate-400 leading-snug">Timed proctored simulation. Grades revealed after submit.</p>
                  </button>

                  <button type="button" data-mode="study" class="mode-card text-left p-3.5 rounded-xl border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/60 hover:border-slate-300 transition-all focus:outline-none">
                    <div class="flex items-center justify-between mb-1">
                      <span class="font-bold text-sm text-slate-900 dark:text-white">Study Mode</span>
                      <span class="mode-dot w-3.5 h-3.5 rounded-full border-2 border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800"></span>
                    </div>
                    <p class="text-[11px] text-slate-600 dark:text-slate-400 leading-snug">Untimed with immediate answer verification on click.</p>
                  </button>

                  <button id="missedModeCard" type="button" data-mode="missed" class="mode-card text-left p-3.5 rounded-xl border-2 border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800/60 hover:border-slate-300 transition-all focus:outline-none disabled:opacity-50 disabled:cursor-not-allowed">
                    <div class="flex items-center justify-between mb-1">
                      <span class="font-bold text-sm text-slate-900 dark:text-white">Weak Drill</span>
                      <span class="mode-dot w-3.5 h-3.5 rounded-full border-2 border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800"></span>
                    </div>
                    <p id="missedModeDesc" class="text-[11px] text-slate-600 dark:text-slate-400 leading-snug">Practice questions you previously missed.</p>
                  </button>
                </div>
              </div>

              <!-- Timer & Shuffle Controls -->
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div id="durationPickerWrap" class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800/70 border border-slate-200 dark:border-slate-700">
                  <label for="durationSelect" class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1">Time Limit</label>
                  <select id="durationSelect" class="w-full bg-transparent text-sm font-bold text-slate-900 dark:text-white focus:outline-none cursor-pointer">
                    <option value="1500" class="text-slate-900">25 Minutes</option>
                    <option value="1800" selected class="text-slate-900">30 Minutes (Std)</option>
                    <option value="2700" class="text-slate-900">45 Minutes</option>
                  </select>
                </div>

                <label class="flex items-center justify-between p-3 rounded-xl bg-slate-50 dark:bg-slate-800/70 border border-slate-200 dark:border-slate-700 cursor-pointer">
                  <div>
                    <span class="block text-xs font-bold text-slate-800 dark:text-slate-100">Shuffle Qs</span>
                    <span class="block text-[11px] text-slate-500 dark:text-slate-400">Random order</span>
                  </div>
                  <input id="shuffleQuestionsChk" type="checkbox" class="w-4 h-4 rounded text-sky-600 focus:ring-sky-500 cursor-pointer" />
                </label>

                <label class="flex items-center justify-between p-3 rounded-xl bg-slate-50 dark:bg-slate-800/70 border border-slate-200 dark:border-slate-700 cursor-pointer">
                  <div>
                    <span class="block text-xs font-bold text-slate-800 dark:text-slate-100">Shuffle A/B/C</span>
                    <span class="block text-[11px] text-slate-500 dark:text-slate-400">Random choices</span>
                  </div>
                  <input id="shuffleOptionsChk" type="checkbox" class="w-4 h-4 rounded text-sky-600 focus:ring-sky-500 cursor-pointer" />
                </label>
              </div>

              <!-- Launch CTA -->
              <div>
                <button id="launchExamBtn" type="button" class="w-full py-3.5 px-6 rounded-xl bg-sky-600 hover:bg-sky-700 active:scale-[0.99] text-white font-bold text-base shadow-md shadow-sky-600/20 transition-all flex items-center justify-center gap-2.5">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                    <polygon points="5 3 19 12 5 21 5 3"></polygon>
                  </svg>
                  <span id="launchBtnLabel">Begin Official Examination</span>
                </button>
                <p class="text-[11px] text-slate-400 dark:text-slate-500 text-center mt-2.5">
                  Shortcuts: <kbd class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 font-mono">A/B/C</kbd> answer · <kbd class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 font-mono">←/→</kbd> navigate · <kbd class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 font-mono">F</kbd> flag · Right-click option to cross out
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column: Persistent Memory Analytics & History (5 cols) -->
        <div class="lg:col-span-5 space-y-6">
          <!-- Performance & Bank Mastery Card -->
          <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm p-5 sm:p-6 space-y-4">
            <div class="flex items-center justify-between">
              <h2 class="text-base font-bold text-slate-900 dark:text-white">Performance Memory</h2>
              <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold text-emerald-600 dark:text-emerald-400">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                Local Storage Active
              </span>
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/70 border border-slate-200/80 dark:border-slate-700/80">
                <p class="text-xs font-semibold text-slate-500 dark:text-slate-400">Completed</p>
                <p id="kpiAttempts" class="text-2xl font-extrabold mt-0.5">0</p>
              </div>
              <div class="p-3.5 rounded-xl bg-emerald-50/70 dark:bg-emerald-950/30 border border-emerald-200/80 dark:border-emerald-800/50">
                <p class="text-xs font-semibold text-emerald-700 dark:text-emerald-400">Best Grade</p>
                <p id="kpiBest" class="text-2xl font-extrabold text-emerald-700 dark:text-emerald-300 mt-0.5">—</p>
              </div>
              <div class="p-3.5 rounded-xl bg-sky-50/70 dark:bg-sky-950/30 border border-sky-200/80 dark:border-sky-800/50">
                <p class="text-xs font-semibold text-sky-700 dark:text-sky-400">Avg Score</p>
                <p id="kpiAvg" class="text-2xl font-extrabold text-sky-700 dark:text-sky-300 mt-0.5">—</p>
              </div>
              <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/70 border border-slate-200/80 dark:border-slate-700/80">
                <p class="text-xs font-semibold text-slate-500 dark:text-slate-400">Pass Rate</p>
                <p id="kpiPassRate" class="text-2xl font-extrabold mt-0.5">—</p>
              </div>
            </div>

            <!-- Question Bank Mastery Bar -->
            <div class="pt-1">
              <div class="flex items-center justify-between text-xs mb-1.5">
                <span class="font-semibold text-slate-600 dark:text-slate-300">Question Bank Mastery</span>
                <span id="masteryLabel" class="font-mono font-bold text-slate-800 dark:text-slate-200">0 / 25 mastered</span>
              </div>
              <div class="w-full h-2.5 rounded-full bg-slate-200 dark:bg-slate-800 overflow-hidden">
                <div id="masteryBar" class="h-full bg-gradient-to-r from-sky-500 to-emerald-500 transition-all duration-500 rounded-full" style="width: 0%"></div>
              </div>
            </div>
          </div>

          <!-- Past Attempts Transcript List -->
          <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm p-5 sm:p-6">
            <div class="flex items-center justify-between mb-3.5">
              <h2 class="text-base font-bold text-slate-900 dark:text-white">Attempt Transcripts</h2>
              <button id="resetMemoryBtn" type="button" class="hidden text-xs font-semibold text-rose-600 dark:text-rose-400 hover:underline">
                Clear Memory
              </button>
            </div>
            <div id="historyContainer" class="space-y-2.5 max-h-80 overflow-y-auto pr-1">
              <!-- Populated dynamically -->
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ================================================================ -->
    <!-- VIEW 2: ACTIVE CBT EXAM INTERFACE                                -->
    <!-- ================================================================ -->
    <section id="viewExam" class="hidden">
