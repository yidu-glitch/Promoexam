    </div>
  </header>

  <main class="main-wrap">

    <!-- SCREEN 1: PRE-EXAM BRIEFING / SETUP -->
    <section id="setupScreen">
      <div class="setup-card">
        <div class="setup-hero">
          <span class="badge-code">Official Bank • Code 7</span>
          <h1>Aviation Maintenance Promotion CBT</h1>
          <p>
            Simulated computer-based examination covering FAR &amp; EASA Part 66 Regulations, Fuel Tank Safety (CDCCL), EWIS, Maintenance Documentation, and Aviation Human Factors.
          </p>
          <div class="setup-stats">
            <div class="setup-stat">
              <div class="setup-stat-label">Questions</div>
              <div class="setup-stat-value">25 Items</div>
            </div>
            <div class="setup-stat">
              <div class="setup-stat-label">Topics</div>
              <div class="setup-stat-value">5 Domains</div>
            </div>
            <div class="setup-stat">
              <div class="setup-stat-label">Pass Mark</div>
              <div class="setup-stat-value" id="previewPassMark">75%</div>
            </div>
            <div class="setup-stat">
              <div class="setup-stat-label">Format</div>
              <div class="setup-stat-value">Multiple Choice</div>
            </div>
          </div>
        </div>

        <div class="setup-body">
          <label style="display:block; font-size:0.85rem; font-weight:700; color:var(--slate-700); margin-bottom:10px;">
            Select Testing Mode
          </label>
          <div class="mode-selector">
            <div class="mode-card selected" id="modeExamCard" onclick="selectMode('exam')">
              <div class="mode-card-title">
                <span>Timed CBT Exam Mode</span>
                <span style="font-size:0.75rem; color:var(--blue-600);">Recommended</span>
              </div>
              <div class="mode-card-desc">
                Simulates real exam conditions. Countdown timer active; answers and explanations are revealed only after final submission.
              </div>
            </div>
            <div class="mode-card" id="modePracticeCard" onclick="selectMode('practice')">
              <div class="mode-card-title">
                <span>Interactive Study Mode</span>
              </div>
              <div class="mode-card-desc">
                Check each answer immediately with instant technical feedback and explanations while tracking your overall score.
              </div>
            </div>
          </div>

          <div class="form-grid">
            <div class="form-group">
              <label for="candidateNameInput">Candidate Name</label>
              <input type="text" id="candidateNameInput" class="form-control" placeholder="e.g., Alex Morgan" value="Aviation Technician" />
            </div>
            <div class="form-group">
              <label for="timeLimitSelect">Time Limit</label>
              <select id="timeLimitSelect" class="form-control">
                <option value="20">20 Minutes (Strict)</option>
                <option value="30" selected>30 Minutes (Standard)</option>
                <option value="45">45 Minutes (Extended)</option>
                <option value="0">Untimed</option>
              </select>
            </div>
            <div class="form-group">
              <label for="passThresholdSelect">Passing Grade Threshold</label>
              <select id="passThresholdSelect" class="form-control" onchange="document.getElementById('previewPassMark').textContent = this.value + '%'">
                <option value="70">70% (18 / 25)</option>
                <option value="75" selected>75% (19 / 25 — EASA Standard)</option>
                <option value="80">80% (20 / 25)</option>
              </select>
            </div>
            <div class="form-group">
              <label>Order Options</label>
              <div style="display:flex; gap:16px; padding-top:8px;">
                <label class="checkbox-label">
                  <input type="checkbox" id="shuffleQuestionsChk" />
                  Shuffle Questions
                </label>
                <label class="checkbox-label">
                  <input type="checkbox" id="shuffleOptionsChk" />
                  Shuffle Choices
                </label>
              </div>
            </div>
          </div>

          <div class="setup-footer">
            <div class="shortcut-hint">
              Shortcuts during exam: <strong>A / B / C</strong> select answer • <strong>← / →</strong> navigate • <strong>F</strong> flag
            </div>
            <button id="startExamBtn" class="btn btn-primary" style="padding: 12px 28px; font-size: 0.96rem;">
              Begin CBT Examination →
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- SCREEN 2: ACTIVE CBT WORKSPACE -->
    <section id="examScreen" class="hidden">
      <div class="exam-layout">
        <!-- Left: Active Question Card -->
        <div class="question-panel">
          <div class="question-topbar">
            <div class="q-meta">
              <span class="q-number-badge" id="qNumberBadge">Question 1 of 25</span>
