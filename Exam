            <p id="resultSubtext" style="opacity:0.9; font-size:0.92rem;">Candidate: Aviation Technician • PromExam Code 7</p>
          </div>
          <div class="results-score-big">
            <div class="score-percent" id="scorePercent">84%</div>
            <div class="score-fraction" id="scoreFraction">21 / 25 Marks</div>
          </div>
        </div>

        <div class="report-meta-grid">
          <div class="report-meta-cell">
            <div class="meta-label">Started On</div>
            <div class="meta-value" id="metaStarted">—</div>
          </div>
          <div class="report-meta-cell">
            <div class="meta-label">Completed On</div>
            <div class="meta-value" id="metaCompleted">—</div>
          </div>
          <div class="report-meta-cell">
            <div class="meta-label">Time Taken</div>
            <div class="meta-value" id="metaDuration">—</div>
          </div>
          <div class="report-meta-cell">
            <div class="meta-label">Pass Requirement</div>
            <div class="meta-value" id="metaPassReq">75%</div>
          </div>
        </div>

        <div class="results-body">
          <div class="section-heading">Domain Performance Breakdown</div>
          <div id="topicBarsContainer" class="topic-bars"></div>

          <div class="results-actions">
            <button id="retakeAllBtn" class="btn btn-primary">Retake Full Exam</button>
