        ],
        correctId: "c",
        explanation: "Matches the official PromExam Code 7 answer key: 'Management decisions concerning non-immediate work'."
      },
      {
        id: 23,
        topic: "Human Factors & Safety",
        question: "Which one of the following Dirty Dozen is the number one cause of forgetting things?",
        options: [
          { id: "a", text: "Distraction" },
          { id: "b", text: "Assertiveness" },
          { id: "c", text: "Lack of communication" }
        ],
        correctId: "a",
        explanation: "Distraction is widely cited in aviation Human Factors (Dirty Dozen) training as the #1 cause of forgetting steps during maintenance tasks."
      },
      {
        id: 24,
        topic: "EWIS & Electrical Safety",
        question: "Which principle causes damage to EWIS?",
        options: [
          { id: "a", text: "Clean as you go" },
          { id: "b", text: "Conduct proper maintenance" },
          { id: "c", text: "Fit and forget" }
        ],
        correctId: "c",
        explanation: "Historically treating aircraft wiring as a 'fit and forget' system led to undetected chafing, contamination, and degradation; modern EWIS programs require active inspection and 'clean as you go' housekeeping."
      },
      {
        id: 25,
        topic: "EWIS & Electrical Safety",
        question: "Wiring may not be affected by:",
        options: [
          { id: "a", text: "Maintenance and repair" },
          { id: "b", text: "Environment and Installation" },
          { id: "c", text: "The number of contacts in a standard Cannon plug" }
        ],
        correctId: "c",
        explanation: "Aircraft wiring degradation is influenced by environment (heat, vibration, moisture), installation practices, and maintenance/repair actions—not simply the contact count of a standard Cannon plug."
      }
    ];

    // Application State
    let config = {
      mode: "exam", // 'exam' | 'practice'
      candidateName: "Aviation Technician",
      timeLimitMinutes: 30,
      passThreshold: 75,
      shuffleQuestions: false,
      shuffleOptions: false
    };

    let session = {
      questions: [],
      currentIndex: 0,
      answers: {},       // { questionId: optionId }
      checked: {},       // { questionId: true } (for practice mode)
      flagged: new Set(),
      startTime: null,
      endTime: null,
      secondsRemaining: 0,
      timerInterval: null,
      submitted: false,
      reviewFilter: "all"
    };

    // DOM Elements
    const setupScreen = document.getElementById("setupScreen");
    const examScreen = document.getElementById("examScreen");
    const resultsScreen = document.getElementById("resultsScreen");
    const headerExamControls = document.getElementById("headerExamControls");
    const timerPill = document.getElementById("timerPill");
    const timerDisplay = document.getElementById("timerDisplay");

    // Mode Selection
    function selectMode(mode) {
      config.mode = mode;
      document.getElementById("modeExamCard").classList.toggle("selected", mode === "exam");
      document.getElementById("modePracticeCard").classList.toggle("selected", mode === "practice");
    }

    // Fisher-Yates Shuffle
    function shuffleArray(arr) {
      const copy = [...arr];
      for (let i = copy.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [copy[i], copy[j]] = [copy[j], copy[i]];
      }
      return copy;
    }

    // Initialize & Start Exam Session
    function startSession(customQuestions = null) {
      config.candidateName = document.getElementById("candidateNameInput").value.trim() || "Aviation Technician";
      config.timeLimitMinutes = parseInt(document.getElementById("timeLimitSelect").value, 10);
      config.passThreshold = parseInt(document.getElementById("passThresholdSelect").value, 10);
      config.shuffleQuestions = document.getElementById("shuffleQuestionsChk").checked;
      config.shuffleOptions = document.getElementById("shuffleOptionsChk").checked;

      let baseList = customQuestions ? customQuestions : QUESTION_BANK;
      let prepared = baseList.map(q => ({
        ...q,
        options: config.shuffleOptions ? shuffleArray(q.options) : [...q.options]
      }));

      if (config.shuffleQuestions) {
        prepared = shuffleArray(prepared);
      }

      clearInterval(session.timerInterval);
      session = {
        questions: prepared,
        currentIndex: 0,
        answers: {},
        checked: {},
        flagged: new Set(),
        startTime: new Date(),
        endTime: null,
        secondsRemaining: config.timeLimitMinutes * 60,
        timerInterval: null,
        submitted: false,
        reviewFilter: "all"
      };

      setupScreen.classList.add("hidden");
      resultsScreen.classList.add("hidden");
      examScreen.classList.remove("hidden");
      headerExamControls.classList.remove("hidden");

      startTimer();
      renderQuestion();
      renderPalette();
      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    // Timer Logic
    function startTimer() {
      clearInterval(session.timerInterval);
      timerPill.classList.remove("warning", "danger");

      if (config.timeLimitMinutes === 0) {
        timerDisplay.textContent = "Untimed";
        return;
      }

      updateTimerUI();
      session.timerInterval = setInterval(() => {
        session.secondsRemaining--;
        updateTimerUI();

        if (session.secondsRemaining <= 0) {
          clearInterval(session.timerInterval);
          finalizeExam(true);
        }
      }, 1000);
    }

    function updateTimerUI() {
      const mins = Math.floor(Math.max(0, session.secondsRemaining) / 60);
      const secs = Math.max(0, session.secondsRemaining) % 60;
      timerDisplay.textContent = `${String(mins).padStart(2, "0")}:${String(secs).padStart(2, "0")}`;

      timerPill.classList.remove("warning", "danger");
      if (session.secondsRemaining <= 60) {
        timerPill.classList.add("danger");
      } else if (session.secondsRemaining <= 300) {
        timerPill.classList.add("warning");
      }
    }

    // Render Active Question
    function renderQuestion() {
      const q = session.questions[session.currentIndex];
      const total = session.questions.length;
      const selectedId = session.answers[q.id];
      const isChecked = !!session.checked[q.id];

      document.getElementById("qNumberBadge").textContent = `Question ${session.currentIndex + 1} of ${total}`;
      document.getElementById("qTopicBadge").textContent = q.topic;
      document.getElementById("questionText").textContent = q.question;

      // Flag button state
      const flagBtn = document.getElementById("flagBtn");
      const isFlagged = session.flagged.has(q.id);
      flagBtn.classList.toggle("active", isFlagged);
      document.getElementById("flagBtnText").textContent = isFlagged ? "Flagged" : "Flag for Review";

      // Options
      const optionsContainer = document.getElementById("optionsContainer");
      optionsContainer.innerHTML = "";
      const letters = ["A", "B", "C", "D"];

      q.options.forEach((opt, idx) => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "option-item";

        if (selectedId === opt.id) {
          btn.classList.add("selected");
        }

        if (config.mode === "practice" && isChecked) {
          btn.classList.add("locked");
          if (opt.id === q.correctId) {
            btn.classList.add("correct-reveal");
          } else if (selectedId === opt.id && opt.id !== q.correctId) {
            btn.classList.add("wrong-reveal");
          }
        }

        btn.innerHTML = `
          <span class="option-letter">${letters[idx]}</span>
          <span class="option-text">${opt.text}</span>
        `;

        btn.addEventListener("click", () => {
          if (config.mode === "practice" && session.checked[q.id]) return;
          session.answers[q.id] = opt.id;
          renderQuestion();
          renderPalette();
        });

        optionsContainer.appendChild(btn);
      });

      // Practice Mode controls & feedback
      const checkBtn = document.getElementById("checkAnswerBtn");
      const feedbackBox = document.getElementById("practiceFeedback");

      if (config.mode === "practice") {
        checkBtn.classList.toggle("hidden", isChecked);
        checkBtn.disabled = !selectedId;

        if (isChecked) {
          const isCorrect = selectedId === q.correctId;
          feedbackBox.classList.remove("hidden", "correct", "incorrect");
          feedbackBox.classList.add(isCorrect ? "correct" : "incorrect");
          const correctOpt = q.options.find(o => o.id === q.correctId);
          document.getElementById("practiceFeedbackTitle").textContent = isCorrect
            ? "Correct Answer!"
            : `Incorrect — Correct Answer: ${correctOpt.text}`;
          document.getElementById("practiceFeedbackBody").textContent = q.explanation;
        } else {
          feedbackBox.classList.add("hidden");
        }
      } else {
        checkBtn.classList.add("hidden");
        feedbackBox.classList.add("hidden");
      }

      // Navigation buttons
      document.getElementById("prevBtn").disabled = session.currentIndex === 0;
      document.getElementById("clearChoiceBtn").disabled = !selectedId || (config.mode === "practice" && isChecked);

      const nextBtn = document.getElementById("nextBtn");
      if (session.currentIndex === total - 1) {
        nextBtn.textContent = "Finish & Submit";
        nextBtn.classList.remove("btn-primary");
        nextBtn.classList.add("btn-success");
      } else {
        nextBtn.textContent = "Next Question →";
        nextBtn.classList.add("btn-primary");
        nextBtn.classList.remove("btn-success");
      }
    }

    // Render Sidebar Palette
    function renderPalette() {
      const grid = document.getElementById("paletteGrid");
      grid.innerHTML = "";

      const total = session.questions.length;
      const answeredCount = Object.keys(session.answers).length;
      const flaggedCount = session.flagged.size;

      document.getElementById("navProgressText").textContent = `${answeredCount} / ${total} Answered`;
      document.getElementById("progressBarFill").style.width = `${Math.round((answeredCount / total) * 100)}%`;
      document.getElementById("countAnswered").textContent = answeredCount;
      document.getElementById("countRemaining").textContent = total - answeredCount;
      document.getElementById("countFlagged").textContent = flaggedCount;

      session.questions.forEach((q, idx) => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "palette-btn";
        btn.textContent = idx + 1;

        const ans = session.answers[q.id];
        if (ans !== undefined) {
          if (config.mode === "practice" && session.checked[q.id]) {
            btn.classList.add(ans === q.correctId ? "practice-correct" : "practice-wrong");
          } else {
            btn.classList.add("answered");
          }
        }

        if (session.flagged.has(q.id)) {
          btn.classList.add("flagged");
        }

        if (idx === session.currentIndex) {
          btn.classList.add("current");
        }

        btn.addEventListener("click", () => {
          session.currentIndex = idx;
          renderQuestion();
          renderPalette();
        });

        grid.appendChild(btn);
      });
    }

    // Submit Confirmation Modal
    function openSubmitModal() {
      const total = session.questions.length;
      const answered = Object.keys(session.answers).length;
      const unanswered = total - answered;
      const flagged = session.flagged.size;

      document.getElementById("modalAnswered").textContent = answered;
      document.getElementById("modalUnanswered").textContent = unanswered;
      document.getElementById("modalFlagged").textContent = flagged;

      const warn = document.getElementById("modalWarningText");
      if (unanswered > 0 && flagged > 0) {
        warn.textContent = `Heads up: You have ${unanswered} unanswered and ${flagged} flagged question(s).`;
      } else if (unanswered > 0) {
        warn.textContent = `Heads up: You still have ${unanswered} unanswered question(s).`;
      } else if (flagged > 0) {
        warn.textContent = `Note: You have ${flagged} question(s) flagged for review.`;
      } else {
        warn.textContent = "All questions answered. You are ready to submit!";
        warn.style.color = "var(--emerald-600)";
      }

      if (unanswered > 0 || flagged > 0) {
        warn.style.color = "var(--amber-600)";
      }

      document.getElementById("submitModal").classList.remove("hidden");
    }

    function closeSubmitModal() {
      document.getElementById("submitModal").classList.add("hidden");
    }

    // Finalize & Grade Exam
    function finalizeExam(autoSubmitted = false) {
      closeSubmitModal();
      clearInterval(session.timerInterval);
      session.submitted = true;
      session.endTime = new Date();

      examScreen.classList.add("hidden");
      headerExamControls.classList.add("hidden");
      resultsScreen.classList.remove("hidden");

      const total = session.questions.length;
      let correctCount = 0;
      const topicStats = {};
      const missedQuestions = [];

      session.questions.forEach(q => {
        if (!topicStats[q.topic]) {
          topicStats[q.topic] = { correct: 0, total: 0 };
        }
        topicStats[q.topic].total++;

        if (session.answers[q.id] === q.correctId) {
          correctCount++;
          topicStats[q.topic].correct++;
        } else {
          missedQuestions.push(q);
        }
      });

      const percent = Math.round((correctCount / total) * 100);
      const passed = percent >= config.passThreshold;

      // Results Header
      const resultsTop = document.getElementById("resultsTop");
      resultsTop.classList.toggle("pass", passed);
      resultsTop.classList.toggle("fail", !passed);

      document.getElementById("resultStatusPill").textContent = passed ? "PASSED" : "DID NOT PASS";
      document.getElementById("resultHeadline").textContent = passed
        ? "Congratulations, you have successfully passed the examination!"
        : "Score below threshold — review the missed items and try again.";
      document.getElementById("resultSubtext").textContent =
        `Candidate: ${config.candidateName} • Mode: ${config.mode === "exam" ? "Timed CBT" : "Study Mode"}${autoSubmitted ? " • Auto-submitted (Time Expired)" : ""}`;

      document.getElementById("scorePercent").textContent = `${percent}%`;
      document.getElementById("scoreFraction").textContent = `${correctCount} / ${total} Marks`;

      // Metadata
      const fmtDate = (d) => d.toLocaleString(undefined, {
        month: "short", day: "numeric", year: "numeric", hour: "2-digit", minute: "2-digit"
      });
      const elapsedSecs = Math.max(1, Math.round((session.endTime - session.startTime) / 1000));
      const eMins = Math.floor(elapsedSecs / 60);
      const eSecs = elapsedSecs % 60;

      document.getElementById("metaStarted").textContent = fmtDate(session.startTime);
      document.getElementById("metaCompleted").textContent = fmtDate(session.endTime);
      document.getElementById("metaDuration").textContent = `${eMins} min ${eSecs} sec`;
      document.getElementById("metaPassReq").textContent = `${config.passThreshold}%`;

      // Topic Breakdown Bars
      const topicContainer = document.getElementById("topicBarsContainer");
      topicContainer.innerHTML = "";
      Object.entries(topicStats).forEach(([topic, data]) => {
        const pct = Math.round((data.correct / data.total) * 100);
        const barColor = pct >= config.passThreshold ? "var(--emerald-600)" : pct >= 50 ? "var(--amber-500)" : "var(--rose-600)";
        const item = document.createElement("div");
        item.innerHTML = `
          <div class="topic-bar-head">
            <span>${topic}</span>
            <span>${data.correct}/${data.total} (${pct}%)</span>
          </div>
          <div class="topic-track">
            <div class="topic-fill" style="width:${pct}%; background:${barColor};"></div>
          </div>
        `;
        topicContainer.appendChild(item);
      });

      // Retry Missed Button
      const retryMissedBtn = document.getElementById("retryMissedBtn");
      if (missedQuestions.length === 0) {
        retryMissedBtn.classList.add("hidden");
      } else {
        retryMissedBtn.classList.remove("hidden");
        retryMissedBtn.textContent = `Retry Missed Questions (${missedQuestions.length})`;
        retryMissedBtn.onclick = () => startSession(missedQuestions);
      }

      // Render Review List
      session.reviewFilter = "all";
      updateFilterTabsUI();
      renderReviewList();
      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    function updateFilterTabsUI() {
      document.querySelectorAll("#reviewFilterTabs .filter-tab").forEach(tab => {
        tab.classList.toggle("active", tab.dataset.filter === session.reviewFilter);
      });
    }

    function renderReviewList() {
      const container = document.getElementById("reviewList");
      container.innerHTML = "";

      const filtered = session.questions.map((q, idx) => ({ q, idx })).filter(({ q }) => {
        const ans = session.answers[q.id];
        const isCorrect = ans === q.correctId;
        if (session.reviewFilter === "correct") return isCorrect;
        if (session.reviewFilter === "wrong") return !isCorrect;
        if (session.reviewFilter === "flagged") return session.flagged.has(q.id);
        return true;
      });

      if (filtered.length === 0) {
        container.innerHTML = `
          <div class="review-card" style="text-align:center; color:var(--slate-500);">
            No questions match this filter.
          </div>
        `;
        return;
      }

      filtered.forEach(({ q, idx }) => {
        const userAnsId = session.answers[q.id];
        const isCorrect = userAnsId === q.correctId;
        const userOpt = q.options.find(o => o.id === userAnsId);
        const correctOpt = q.options.find(o => o.id === q.correctId);
        const isFlagged = session.flagged.has(q.id);

        const card = document.createElement("div");
        card.className = `review-card ${isCorrect ? "is-correct" : "is-wrong"}`;

        const statusBadge = userAnsId === undefined
          ? `<span class="status-tag unanswered">Unanswered</span>`
          : isCorrect
            ? `<span class="status-tag correct">Correct</span>`
            : `<span class="status-tag wrong">Incorrect</span>`;

        card.innerHTML = `
          <div class="review-card-head">
            <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
              <strong>Question ${idx + 1}</strong>
              <span class="q-topic-badge">${q.topic}</span>
              ${isFlagged ? `<span class="status-tag" style="background:var(--amber-50); color:var(--amber-600); border:1px solid var(--amber-200);">Flagged</span>` : ""}
            </div>
            ${statusBadge}
          </div>
          <div class="review-q-text">${q.question}</div>
          <div class="review-answers">
            ${!isCorrect && userOpt ? `<div class="review-ans-row user-wrong"><strong>Your Answer:</strong> ${userOpt.text}</div>` : ""}
            <div class="review-ans-row correct-ans"><strong>Correct Answer:</strong> ${correctOpt.text}</div>
          </div>
          <div class="review-explanation">
            <strong>Explanation:</strong> ${q.explanation}
          </div>
        `;

        container.appendChild(card);
      });
    }

    // Event Listeners
    document.getElementById("startExamBtn").addEventListener("click", () => startSession());

    document.getElementById("prevBtn").addEventListener("click", () => {
      if (session.currentIndex > 0) {
        session.currentIndex--;
        renderQuestion();
        renderPalette();
      }
    });

    document.getElementById("nextBtn").addEventListener("click", () => {
      if (session.currentIndex < session.questions.length - 1) {
        session.currentIndex++;
        renderQuestion();
        renderPalette();
      } else {
        openSubmitModal();
      }
    });

    document.getElementById("clearChoiceBtn").addEventListener("click", () => {
      const q = session.questions[session.currentIndex];
      delete session.answers[q.id];
      renderQuestion();
      renderPalette();
    });

    document.getElementById("flagBtn").addEventListener("click", () => {
      const q = session.questions[session.currentIndex];
      if (session.flagged.has(q.id)) {
        session.flagged.delete(q.id);
      } else {
        session.flagged.add(q.id);
      }
      renderQuestion();
      renderPalette();
    });

    document.getElementById("checkAnswerBtn").addEventListener("click", () => {
      const q = session.questions[session.currentIndex];
      if (session.answers[q.id]) {
        session.checked[q.id] = true;
        renderQuestion();
        renderPalette();
      }
    });

    document.getElementById("headerFinishBtn").addEventListener("click", openSubmitModal);
    document.getElementById("sidebarFinishBtn").addEventListener("click", openSubmitModal);
    document.getElementById("cancelSubmitBtn").addEventListener("click", closeSubmitModal);
    document.getElementById("confirmSubmitBtn").addEventListener("click", () => finalizeExam(false));

    document.getElementById("retakeAllBtn").addEventListener("click", () => startSession());
    document.getElementById("backToSetupBtn").addEventListener("click", () => {
      resultsScreen.classList.add("hidden");
      setupScreen.classList.remove("hidden");
      window.scrollTo({ top: 0, behavior: "smooth" });
    });

    document.querySelectorAll("#reviewFilterTabs .filter-tab").forEach(tab => {
      tab.addEventListener("click", () => {
        session.reviewFilter = tab.dataset.filter;
        updateFilterTabsUI();
        renderReviewList();
      });
    });

    // Keyboard Shortcuts during active exam
    document.addEventListener("keydown", (e) => {
      if (examScreen.classList.contains("hidden")) return;
      if (!document.getElementById("submitModal").classList.contains("hidden")) {
        if (e.key === "Escape") closeSubmitModal();
        return;
      }
      if (["INPUT", "TEXTAREA", "SELECT"].includes(document.activeElement.tagName)) return;

      const q = session.questions[session.currentIndex];
      const key = e.key.toLowerCase();

      if (key === "arrowright") {
        if (session.currentIndex < session.questions.length - 1) {
          session.currentIndex++;
          renderQuestion();
          renderPalette();
        }
      } else if (key === "arrowleft") {
        if (session.currentIndex > 0) {
          session.currentIndex--;
          renderQuestion();
          renderPalette();
        }
      } else if (key === "f") {
        document.getElementById("flagBtn").click();
      } else if (["a", "b", "c", "1", "2", "3"].includes(key)) {
        if (config.mode === "practice" && session.checked[q.id]) return;
        const map = { a: 0, "1": 0, b: 1, "2": 1, c: 2, "3": 2 };
        const idx = map[key];
        if (q.options[idx]) {
          session.answers[q.id] = q.options[idx].id;
          renderQuestion();
          renderPalette();
        }
      }
    });
  </script>
