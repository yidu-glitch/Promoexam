          </div>

          <button id="sidebarFinishBtn" class="btn btn-primary" style="width: 100%;">
            Review &amp; Submit Exam
          </button>
        </aside>
      </div>
    </section>

    <!-- SCREEN 3: RESULTS & REVIEW REPORT -->
    <section id="resultsScreen" class="hidden">
      <div class="results-banner">
        <div id="resultsTop" class="results-top pass">
          <div>
            <span class="result-status-pill" id="resultStatusPill">PASSED</span>
