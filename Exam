            <button id="backToSetupBtn" class="btn btn-secondary">Change Settings</button>
            <button onclick="window.print()" class="btn btn-secondary">Print Score Report</button>
          </div>
        </div>
      </div>

      <div class="review-controls">
        <h3 style="font-size:1.1rem; font-weight:700;">Detailed Question Review</h3>
        <div class="filter-tabs" id="reviewFilterTabs">
          <button class="filter-tab active" data-filter="all">All</button>
          <button class="filter-tab" data-filter="wrong">Incorrect</button>
          <button class="filter-tab" data-filter="correct">Correct</button>
          <button class="filter-tab" data-filter="flagged">Flagged</button>
        </div>
      </div>

      <div id="reviewList"></div>
    </section>

  </main>

  <!-- Confirm Submit Modal -->
  <div id="submitModal" class="modal-backdrop hidden">
