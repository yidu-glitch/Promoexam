            <div id="practiceFeedback" class="practice-feedback hidden">
              <div class="practice-feedback-title" id="practiceFeedbackTitle"></div>
              <div id="practiceFeedbackBody"></div>
            </div>
          </div>

          <div class="question-footer">
            <div class="footer-group">
              <button id="prevBtn" class="btn btn-secondary">← Previous</button>
              <button id="clearChoiceBtn" class="btn btn-secondary" style="font-size:0.84rem; padding: 9px 13px;">Clear</button>
            </div>
            <div class="footer-group">
              <button id="checkAnswerBtn" class="btn btn-success hidden">Check Answer</button>
              <button id="nextBtn" class="btn btn-primary">Next Question →</button>
            </div>
          </div>
        </div>

        <!-- Right: Question Navigator Palette -->
        <aside class="nav-sidebar">
          <div class="nav-header">
            <span class="nav-title">Question Navigator</span>
            <span class="nav-progress-text" id="navProgressText">0 / 25 Answered</span>
          </div>
          <div class="progress-bar-track">
            <div class="progress-bar-fill" id="progressBarFill" style="width: 0%;"></div>
          </div>

          <div class="nav-summary-counts">
            <span>Answered: <strong id="countAnswered">0</strong></span>
            <span>Left: <strong id="countRemaining">25</strong></span>
